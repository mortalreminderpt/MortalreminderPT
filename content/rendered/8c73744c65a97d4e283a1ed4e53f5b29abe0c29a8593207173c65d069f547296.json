{
  "route": "/zh-cn/contact/",
  "lang": "zh-cn",
  "kind": "contact",
  "title": "Contact",
  "description": "",
  "headerClass": "header header--top",
  "heroHtml": "<section class=\"hero\">\n  <div class=\"hero__inner\">\n    <div class=\"hero__image\">\n      <img class=\"lazy\" data-src=\"https://bing.biturl.top/?resolution=1920&amp;format=image&amp;index=0&amp;mkt=en-US\" alt=\"Contact\">\n    </div>\n    <div class=\"hero__content\">\n      <h1 class=\"hero__title\">Contact</h1>\n    </div>\n  </div>\n</section>",
  "contentHtml": "\n      <div class=\"form-container\">\n  \n  <p class=\"contact-description\">欢迎与博主互动！无论您是有任何建议、疑问，需要帮助，还是想表达对博主的赞赏，都欢迎发送邮件给博主。期待听到您的声音！</p>\n  \n  <form class=\"form\" id=\"contact-form\" action=\"mailto:ptzhao@hotmail.com\" onsubmit=\"return false;\">\n    <div class=\"form__group\">\n      <label class=\"form__label screen-reader-text\" for=\"form-name\">您的称呼</label>\n      <input class=\"form__input\" id=\"form-name\" type=\"text\" name=\"name\" placeholder=\"您的称呼\" autocomplete=\"name\" required=\"\">\n    </div>\n    <div class=\"form__group\">\n      <label class=\"form__label screen-reader-text\" for=\"form-email\">邮箱</label>\n      <input class=\"form__input\" id=\"form-email\" type=\"email\" name=\"email\" placeholder=\"邮箱\" autocomplete=\"email\" required=\"\">\n    </div>\n    <div class=\"form__group\">\n      <label class=\"form__label screen-reader-text\" for=\"form-text\">留言内容</label>\n      <textarea class=\"form__input\" id=\"form-text\" name=\"message\" rows=\"10\" placeholder=\"留言内容\" required=\"\"></textarea>\n    </div>\n    <div class=\"form__group\">\n      <a class=\"button button--primary\" id=\"contact-mail-link\" href=\"mailto:ptzhao@hotmail.com\">留言</a>\n    </div>\n  </form>\n  <hr>\n</div>\n\n\n\n    "
}
