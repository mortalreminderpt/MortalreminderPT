  "contentHtml": "\n      \n\n<h1 align=\"center\">\n  Hi there, I'm PT 👋\n</h1>\n\n<div align=\"center\">\n  <img src=\"https://avatars.githubusercontent.com/u/54986457?v=4\" width=\"150\" style=\"border-radius: 50%; margin-bottom: 50px\">\n</div>\n\n<p><a href=\"https://ptzhao.com/about/\"><img src=\"https://img.shields.io/badge/Home-5A45FF?style=for-the-badge&amp;style=flat&amp;logo=data:image/svg%2bxml;base64,&amp;logoColor=white\" alt=\"Homepage\"></a>\n<a href=\"https://github.com/MortalreminderPT\"><img src=\"https://img.shields.io/badge/-Github-000?style=flat&amp;logo=Github&amp;logoColor=white\" alt=\"Github\"></a>\n<a href=\"https://www.linkedin.com/in/pt-z\"><img src=\"https://img.shields.io/badge/-LinkedIn-blue?style=flat&amp;logo=Linkedin&amp;logoColor=white\" alt=\"Linkedin\"></a>\n<a href=\"mailto:ptzhao@hotmail.com\"><img src=\"https://img.shields.io/badge/-Email-0078D4?style=flat&amp;logo=microsoftoutlook&amp;logoColor=white\" alt=\"Email\"></a>\n<img src=\"https://komarev.com/ghpvc/?username=mortalreminderPT\" alt=\"Views\"></p>\n\n<p align=\"left\">\n  <img src=\"https://img.shields.io/badge/Large%20Language%20Models-blueviolet?style=for-the-badge\">\n  <img src=\"https://img.shields.io/badge/Machine%20Learning-0096FF?style=for-the-badge\">\n  <img src=\"https://img.shields.io/badge/Software%20Engineering-2E8B57?style=for-the-badge\">\n  <img src=\"https://img.shields.io/badge/Computer%20Vision-FF6B6B?style=for-the-badge\">\n  <img src=\"https://img.shields.io/badge/Web%20Development-FFB000?style=for-the-badge\">\n  <img src=\"https://img.shields.io/badge/Human–Computer%20Interaction-7952B3?style=for-the-badge\">\n</p>\n\n<h3 align=\"center\">Just coding for fun</h3>\n\n<div align=\"center\" style=\"display:flex; justify-content:center; gap:20px; flex-wrap:wrap;\">\n  <img src=\"https://github-readme-stats.vercel.app/api?username=mortalreminderpt&amp;show_icons=true&amp;theme=transparent&amp;hide_border=true\" width=\"50%\">\n  <img src=\"https://github-readme-stats.vercel.app/api/top-langs/?username=mortalreminderpt&amp;layout=donut&amp;hide=html&amp;show_icons=true&amp;theme=transparent&amp;hide_border=true\" width=\"45%\">\n</div>\n\n\n\n<h3 id=\"about-me\">About me</h3>\n\n<p>I’m a Software Engineer at AIBUILD and a graduate student in Information Technology at the University of Melbourne. I focus on Software and AI Engineering, stay curious, and continue exploring the broader field of Computer Science.</p>\n\n<h3 id=\"working-on\">Working on</h3>\n<ul>\n  <li>Multimodal AI agents</li>\n  <li>Applied machine learning</li>\n  <li>Scalable LLM workflows</li>\n</ul>\n\n<h3 id=\"hobbies\">Hobbies</h3>\n<ul>\n  <li>Exploring new technologies, tools, and workflows</li>\n  <li>Reading cutting-edge research papers</li>\n  <li>Enjoying Manga, anime, and calm, story-driven media</li>\n  <li>Building and polishing personal infrastructure (NAS, homelab, AI server, etc.)</li>\n</ul>\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    "
}
